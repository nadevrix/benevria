# Defensa contra ataques de cadena de suministro (ChainDrop/Shai-Hulud, ago 2026).
# El vector de esos ataques es un hook preinstall/postinstall. Desactivarlos
# neutraliza el payload aunque se descargue una version envenenada.
ignore-scripts=true
# No instalar nada publicado hace menos de 14 dias: las versiones envenenadas
# suelen retirarse en horas o dias. Da margen de deteccion.
before=2026-07-27
audit-level=moderate
fund=false
