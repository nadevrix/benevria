# Direccion del contrato BenevriaCore desplegado (la imprime `yarn deploy`)
NEXT_PUBLIC_BENEVRIA_ADDRESS=0x0000000000000000000000000000000000000000

# RPC de Arbitrum Sepolia
NEXT_PUBLIC_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# --- Inferencia (opcional) ---
# Sin esto el chat explica el estado en vez de responder. El nivel se sigue
# leyendo del contrato igual.
OPENROUTER_API_KEY=
INFERENCIA_BASE_URL=https://openrouter.ai/api/v1

# apikey = API key tradicional (funciona hoy, hay un humano con tarjeta detras)
# x402   = pago por request en USDC desde la tesoreria (circuito cerrado)
BENEVRIA_MODO_PAGO=apikey

# --- Embeddings (opcional) ---
# Sin esto se usa el respaldo local, que es lexico y no semantico.
EMBEDDINGS_API_KEY=
EMBEDDINGS_BASE_URL=https://api.openai.com/v1
EMBEDDINGS_MODEL=text-embedding-3-small
